PORT=4000
# Local Docker/embedded Mongo (default). For MongoDB Atlas, run `npm run connect:atlas`
# or set this to e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel?directConnection=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-secret
CORS_ORIGINS=http://localhost:5173
DEMO_ORG_SLUG=northstar
DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-chars
WEB_BASE_URL=http://localhost:5173
S3_BUCKET=replace-with-a-private-evidence-bucket
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
CLAMAV_HOST=replace-with-a-private-clamav-service
CLAMAV_PORT=3310
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=CyberIR <no-reply@localhost>
